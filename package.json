{
  "name": "malinosland",
  "version": "0.1.0",
  "private": true,
  "description": "MalinosLand — monde virtuel isométrique, gratuit, open source et communautaire pour les Malinos.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docs:screenshots": "node scripts/doc-screenshots.mjs",
    "test:online": "node scripts/online-test.mjs",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
