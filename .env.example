# Copie ce fichier en « .env.local » pour tester le multijoueur en ligne en local.
# 1) Dans un terminal : cd server && npm install && npm run dev   (serveur sur le port 8787)
# 2) Dans un autre :    npm run dev                                (le jeu)
VITE_REALTIME_URL=ws://localhost:8787/ws

# Comptes joueurs (facultatif) : adresse du projet Supabase et sa clé PUBLIQUE « publishable ».
# Laisser vide pour jouer sans comptes. Ne jamais mettre ici une clé « secret » ou « service_role ».
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Anti-robots de la boîte à idées (facultatif) : clé PUBLIQUE (« sitekey ») du widget Cloudflare
# Turnstile. Clé de test toujours valide : 1x00000000000000000000AA. La clé secrète, elle, ne va
# que dans les secrets des fonctions Edge de Supabase (voir docs/COMPTES.md).
VITE_TURNSTILE_SITEKEY=
